# PulseMesh Environment Configuration

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Security & JWT
JWT_SECRET=super-secret-pulsemesh-cyber-jwt-key-2026
JWT_EXPIRES_IN=7d

# PostgreSQL Configuration (Durable Truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pulsemesh
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pulsemesh
PGMAX_CONNECTIONS=20

# Redis Configuration (Transient Queue & Delivery)
REDIS_URL=redis://localhost:6379

# Worker Fleet Configuration
WORKER_CONCURRENCY=5
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_LEASE_DURATION_SECONDS=30

# Recovery Service
RECOVERY_SCAN_INTERVAL_MS=5000
STALE_WORKER_TIMEOUT_SECONDS=15

# Scheduler Configuration
SCHEDULER_POLL_INTERVAL_MS=1000

# Rate Limiting
RATE_LIMIT_MAX_PER_MINUTE=100
BULK_RATE_LIMIT_MAX_PER_MINUTE=10
